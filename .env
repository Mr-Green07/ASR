# Whisper Model Size Options: tiny, base, small, medium, large
MODEL_SIZE=medium

# Device: cpu or cuda (cuda requires NVIDIA GPU)
DEVICE=cuda

# Language code: 'en' for English, 'es' for Spanish, etc.
LANGUAGE=en

# Number of threads for CPU inference (if using CPU)
NUM_THREADS=4
#database sqlite for phase 1 

# Enable Redis caching (true/false)
# Set to 'true' to enable caching for Phase 2+
CACHE_ENABLED=false

# Redis server host and port
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# Cache expiration time in seconds (3600 = 1 hour)
CACHE_EXPIRATION=3600


# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8000

# API prefix for versioning
API_PREFIX=/api/v1

# Reload server on code changes (disable in production)
RELOAD=true

# Enable API documentation
ENABLE_DOCS=true
DOCS_PATH=/docs

# ==================== OUTPUT CONFIGURATION ====================

# Output format: json, txt, vtt, srt
# json - structured JSON output
# txt - plain text
# vtt - WebVTT subtitle format
# srt - SRT subtitle format
OUTPUT_FORMAT=json

# Output directory for transcriptions
OUTPUT_DIR=./output

# ==================== LOGGING CONFIGURATION ====================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=./data/logs/phase1.log

# Maximum log file size in MB
LOG_MAX_SIZE=100

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ==================== FILE UPLOAD CONFIGURATION ====================

# Maximum file upload size in MB (0 = unlimited)
MAX_UPLOAD_SIZE=500

# Allowed audio formats
ALLOWED_FORMATS=mp3,wav,m4a,flac,ogg,webm

# Temporary upload directory
TEMP_UPLOAD_DIR=./data/temp

# Beam size for Whisper decoding (1-5, higher = slower but more accurate)
BEAM_SIZE=5

# Number of workers for concurrent requests
NUM_WORKERS=2

# Request timeout in seconds
REQUEST_TIMEOUT=300

# ==================== DATABASE CONFIGURATION ====================

# Database URL (optional for Phase 1)
# Example: sqlite:///./data/database/asr.db
DATABASE_URL=sqlite:///./data/database/asr.db

# Enable database logging
DATABASE_LOG=false

# ==================== FEATURE FLAGS ====================

# Phase 1 Features (Speech-to-Text only)
FEATURE_TRANSCRIPTION=true

# Phase 2+ Features (currently disabled)
FEATURE_SENTIMENT_ANALYSIS=false
FEATURE_NER=false
FEATURE_QUESTION_ANSWERING=false
FEATURE_CACHING=false

# ==================== SECURITY CONFIGURATION ====================

# API Key (optional, for future use)
API_KEY=

# Enable CORS (Cross-Origin Resource Sharing)
ENABLE_CORS=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ==================== DEBUGGING ====================

# Debug mode (enable for development only)
DEBUG=true

# Verbose logging
VERBOSE=false

# Store raw transcription data for debugging
DEBUG_STORAGE=false
